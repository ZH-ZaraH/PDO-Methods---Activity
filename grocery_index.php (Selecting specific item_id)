    <?php
    //Selecting a specified record using the item_id.
    $stmt = $pdo -> prepare("SELECT * FROM netherlands_grocery_items WHERE item_id = 49");
    if ($stmt->execute()) {
        $grocery = $stmt->fetchAll(PDO::FETCH_ASSOC);
        //grocery is the variable, fetching the sql command in the $stmt.
        //using the fetchAll()method to retrieve all data we are looking for in the prepare method. in this case, the item with an id 49.
        //using the PDO::FETCH_ASSOC to return an associative array of the data.
        echo "<pre>";
        print_r($grocery); //using the print_r() and <pre> tags to display the data in a readable format. This will not display the data in table format
        echo "</pre>";
    } else { //will show if the query fails to find the specific data you are looking for.
        echo "<p>No items are found in the database.</p>";
    }
    ?>
